  <!-- Complete Intake Form Section with Validated Lowercase Web3Forms Key -->
  <section id="inquiry" class="py-20 bg-brand-warm border-t border-brand-border">
    <div class="max-w-4xl mx-auto px-6">
      <div class="bg-white p-8 md:p-12 rounded-3xl border border-brand-border shadow-xl">
        
        <div class="text-center max-w-xl mx-auto mb-10 space-y-2">
          <span class="text-brand-rust text-xs font-bold uppercase tracking-widest">Client Intake</span>
          <h2 class="text-3xl font-black text-brand-dark tracking-tight">Request Home Care Services</h2>
          <p class="text-sm text-brand-muted leading-relaxed">
            Provide the client's information below so our care coordinator can verify coverage and review schedule availability.
          </p>
        </div>

        <form 
          action="https://api.web3forms.com/submit" 
          method="POST" 
          class="space-y-8"
        >
          <!-- Exact Lowercase Web3Forms Access Key -->
          <input type="hidden" name="access_key" value="c31a3a15-cc8b-4626-906c-1a76d5fb6a30" />
          <input type="hidden" name="subject" value="New Patient Care Intake" />
          <input type="hidden" name="from_name" value="Loving People Care Desk" />

          <!-- Section 1: Client & Contact Info -->
          <div class="space-y-4">
            <h3 class="text-xs font-bold uppercase tracking-wider text-brand-dark border-b border-brand-border pb-2">
              1. Client & Contact Information
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1">First Name</label>
                <input 
                  type="text" 
                  name="client_first_name" 
                  required 
                  placeholder="First name" 
                  class="w-full px-4 py-3 rounded-xl border border-brand-border text-sm focus:outline-none focus:border-brand-amber bg-brand-warm/30" 
                />
              </div>
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1">Last Name</label>
                <input 
                  type="text" 
                  name="client_last_name" 
                  required 
                  placeholder="Last name" 
                  class="w-full px-4 py-3 rounded-xl border border-brand-border text-sm focus:outline-none focus:border-brand-amber bg-brand-warm/30" 
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1">Contact Phone Number</label>
                <input 
                  type="tel" 
                  name="phone_number" 
                  required 
                  placeholder="(317) 000-0000" 
                  class="w-full px-4 py-3 rounded-xl border border-brand-border text-sm focus:outline-none focus:border-brand-amber bg-brand-warm/30" 
                />
              </div>
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1">Email Address</label>
                <input 
                  type="email" 
                  name="email_address" 
                  placeholder="contact@example.com" 
                  class="w-full px-4 py-3 rounded-xl border border-brand-border text-sm focus:outline-none focus:border-brand-amber bg-brand-warm/30" 
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1">Client Physical Address</label>
              <input 
                type="text" 
                name="client_street_address" 
                required 
                placeholder="Street address, apartment or suite" 
                class="w-full px-4 py-3 rounded-xl border border-brand-border text-sm focus:outline-none focus:border-brand-amber bg-brand-warm/30 mb-3" 
              />
              <div class="grid grid-cols-3 gap-3">
                <input 
                  type="text" 
                  name="client_city" 
                  required 
                  placeholder="City (e.g. Indianapolis)" 
                  class="px-4 py-2.5 rounded-xl border border-brand-border text-sm focus:outline-none focus:border-brand-amber bg-brand-warm/30" 
                />
                <input 
                  type="text" 
                  name="client_state" 
                  value="IN" 
                  class="px-4 py-2.5 rounded-xl border border-brand-border text-sm focus:outline-none focus:border-brand-amber bg-brand-warm/30" 
                />
                <input 
                  type="text" 
                  name="client_zip" 
                  required 
                  placeholder="ZIP Code" 
                  class="px-4 py-2.5 rounded-xl border border-brand-border text-sm focus:outline-none focus:border-brand-amber bg-brand-warm/30" 
                />
              </div>
            </div>
          </div>

          <!-- Section 2: Coverage & Specific Member ID Details -->
          <div class="space-y-4 pt-2">
            <div class="flex items-center justify-between border-b border-brand-border pb-2">
              <h3 class="text-xs font-bold uppercase tracking-wider text-brand-dark">
                2. Insurance Card & Member ID
              </h3>
              <span class="text-[11px] font-semibold text-brand-rust bg-brand-warm px-2.5 py-0.5 rounded-full border border-brand-border">
                Refer to Front of Card
              </span>
            </div>

            <!-- Card Reference Tip Box -->
            <div class="bg-amber-50/60 border border-amber-200/80 p-3.5 rounded-xl flex items-start gap-3 text-xs text-amber-950">
              <svg class="w-4 h-4 text-brand-rust shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
              </svg>
              <p class="leading-relaxed">
                Look at the front of the health plan card. Enter the provider name (e.g. <em>Indiana Medicaid, Anthem</em>), the exact <strong>Pathways ID</strong> number, and the member name as printed on the card.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1">
                  Insurance Carrier / Plan Name <span class="text-brand-rust">*</span>
                </label>
                <input 
                  type="text" 
                  name="insurance_carrier" 
                  required 
                  placeholder="e.g. Indiana Medicaid, Anthem" 
                  class="w-full px-4 py-3 rounded-xl border border-brand-border text-sm focus:outline-none focus:border-brand-amber bg-brand-warm/30" 
                />
              </div>
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1 flex items-center justify-between">
                  <span>Member ID / Pathways ID Number <span class="text-brand-rust">*</span></span>
                  <span class="text-[10px] text-brand-muted font-normal">Found on front of card</span>
                </label>
                <input 
                  type="text" 
                  name="member_id" 
                  required 
                  placeholder="e.g. 48281611" 
                  class="w-full px-4 py-3 rounded-xl border-2 border-brand-amber/60 bg-white text-sm font-mono font-bold tracking-wide text-brand-dark focus:outline-none focus:border-brand-rust" 
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1">
                  Member Name (As Printed on Card) <span class="text-brand-rust">*</span>
                </label>
                <input 
                  type="text" 
                  name="cardholder_name" 
                  required 
                  placeholder="e.g. FIRST M LAST 00 MED" 
                  class="w-full px-4 py-3 rounded-xl border border-brand-border text-sm focus:outline-none focus:border-brand-amber bg-brand-warm/30" 
                />
              </div>
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1">
                  Date of Birth <span class="text-brand-rust">*</span>
                </label>
                <input 
                  type="date" 
                  name="client_dob" 
                  required
                  class="w-full px-4 py-3 rounded-xl border border-brand-border text-sm focus:outline-none focus:border-brand-amber bg-brand-warm/30" 
                />
              </div>
            </div>

            <!-- Existing Agency / HHA Hours Question -->
            <div class="bg-brand-warm/50 border border-brand-border p-5 rounded-2xl space-y-3 mt-2">
              <label class="block text-xs font-bold uppercase tracking-wider text-brand-dark">
                Do you currently receive home care coverage or have active Home Health Aide (HHA) hours with another agency?
              </label>
              <div class="flex items-center gap-6 text-sm font-semibold text-brand-dark">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="current_hha_coverage" value="No" checked class="accent-brand-rust" />
                  No, not currently with an agency
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="current_hha_coverage" value="Yes" class="accent-brand-rust" />
                  Yes, currently receiving hours
                </label>
              </div>
              <input 
                type="text" 
                name="current_agency_details" 
                placeholder="If yes, name of current agency and approximate weekly hours (optional)" 
                class="w-full px-4 py-2.5 rounded-xl border border-brand-border text-xs focus:outline-none focus:border-brand-amber bg-white" 
              />
            </div>
          </div>

          <!-- Section 3: Physician Details -->
          <div class="space-y-4 pt-2">
            <h3 class="text-xs font-bold uppercase tracking-wider text-brand-dark border-b border-brand-border pb-2">
              3. Primary Care Physician (PCP)
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1">Doctor / Clinic Name</label>
                <input 
                  type="text" 
                  name="primary_care_doctor" 
                  required 
                  placeholder="Dr. Smith / Eskenazi / Community Health" 
                  class="w-full px-4 py-3 rounded-xl border border-brand-border text-sm focus:outline-none focus:border-brand-amber bg-brand-warm/30" 
                />
              </div>
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1">Date of Last Doctor Visit</label>
                <input 
                  type="date" 
                  name="last_doctor_visit" 
                  class="w-full px-4 py-3 rounded-xl border border-brand-border text-sm focus:outline-none focus:border-brand-amber bg-brand-warm/30" 
                />
              </div>
            </div>
          </div>

          <!-- Section 4: Notes / Services of Interest -->
          <div class="space-y-4 pt-2">
            <h3 class="text-xs font-bold uppercase tracking-wider text-brand-dark border-b border-brand-border pb-2">
              4. Additional Care Notes
            </h3>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1">Services Needed or Special Requests</label>
              <textarea 
                name="additional_care_notes" 
                rows="3" 
                placeholder="e.g., Assistance with morning transfers, bath safety, meal prep requirements..." 
                class="w-full px-4 py-3 rounded-xl border border-brand-border text-sm focus:outline-none focus:border-brand-amber bg-brand-warm/30"
              ></textarea>
            </div>
          </div>

          <button 
            type="submit" 
            class="w-full bg-gradient-to-r from-brand-amber to-brand-rust hover:brightness-105 text-white font-bold py-4 rounded-xl transition shadow-md shadow-brand-rust/20 active:scale-[0.99] text-sm tracking-wide uppercase"
          >
            Submit Care Intake
          </button>
        </form>

      </div>
    </div>
  </section>
