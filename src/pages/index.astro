---
import '../styles/global.css';
---
<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Loving People Home Health Care | Indianapolis, IN</title>
  <link rel="icon" type="image/png" href="/logo.png" />
  <style>
    /* Subdued Micro-Motion: Purposeful scroll choreography */
    .reveal-up {
      opacity: 0;
      transform: translateY(24px);
      transition: all 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .reveal-up.active {
      opacity: 1;
      transform: translateY(0);
    }
    
    /* Tactile depth & Glassmorphism 2.0 utility classes */
    .glass-card {
      background: rgba(255, 255, 255, 0.65);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
    }
    
    /* Smooth floating animation for hero visual */
    @keyframes subtle-float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }
    .animate-float {
      animation: subtle-float 7s ease-in-out infinite;
    }
  </style>
</head>
<body class="bg-brand-warm text-brand-muted font-sans antialiased selection:bg-brand-amber/20 selection:text-brand-dark overflow-x-hidden">

  <!-- Background Depth Texture (Glassmorphism 2.0) -->
  <div class="fixed inset-0 pointer-events-none z-[-1] opacity-40 mix-blend-multiply" style="background-image: radial-gradient(circle at 50% 0%, rgba(245,230,211,0.5) 0%, transparent 70%);"></div>

  <!-- Healthcare Utility Bar -->
  <div class="bg-brand-dark text-white text-xs sm:text-sm py-2.5 px-6 border-b border-brand-dark/50 z-50 relative">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
      <div class="flex items-center gap-3">
        <span class="flex items-center gap-2 bg-brand-amber/20 text-brand-amber px-2 py-0.5 rounded-full text-[10px] font-bold tracking-widest uppercase border border-brand-amber/30">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-amber animate-pulse"></span>
          Availability Badge
        </span>
        <span class="text-stone-300 font-medium tracking-wide">Same-Week Intakes Available • Accepting New Clients</span>
      </div>
      <div class="flex items-center gap-6">
        <a href="tel:3176063803" class="hover:text-brand-amber transition-colors font-semibold flex items-center gap-1.5 active:scale-95 duration-200">
          <svg class="w-4 h-4 text-brand-amber" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
          (317) 606-3803
        </a>
        <span class="hidden md:inline text-stone-600">|</span>
        <span class="hidden md:inline text-stone-400">Mon–Fri: 9AM–6PM · Sat–Sun: 10AM–4PM</span>
      </div>
    </div>
  </div>

  <!-- Primary Sticky Header with Glassmorphism -->
  <header class="sticky top-0 z-40 bg-white/70 backdrop-blur-xl border-b border-white/50 shadow-sm transition-all duration-300">
    <div class="max-w-7xl mx-auto px-6 h-24 flex items-center justify-between">
      <a href="#" class="flex items-center group shrink-0 active:scale-95 transition-transform duration-200">
        <img 
          src="/logo.png" 
          alt="Loving People Home Health Care" 
          class="w-auto object-contain mix-blend-multiply transition-transform duration-500 group-hover:scale-105"
          style="max-height: 4.5rem; height: 4.5rem;"
          onerror="this.style.display='none'; document.getElementById('fallback-logo').style.display='flex';"
        />
        <div id="fallback-logo" style="display:none;" class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-amber to-brand-rust flex items-center justify-center text-white font-black text-xl shadow-md">
            LP
          </div>
          <div>
            <span class="text-xl font-black tracking-tight text-brand-dark uppercase block leading-none">Loving People</span>
            <span class="text-[10px] font-bold tracking-[0.25em] text-brand-rust uppercase block mt-1">Home Health Care</span>
          </div>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-brand-dark">
        <a href="#services" class="hover:text-brand-rust hover:-translate-y-0.5 transition-all duration-200">Care Services</a>
        <a href="#process" class="hover:text-brand-rust hover:-translate-y-0.5 transition-all duration-200">How It Works</a>
        <a href="#inquiry" class="hover:text-brand-rust hover:-translate-y-0.5 transition-all duration-200">Intake Form</a>
        <a href="#contact" class="hover:text-brand-rust hover:-translate-y-0.5 transition-all duration-200">Castleton Office</a>
      </nav>

      <div>
        <a href="#inquiry" class="bg-gradient-to-r from-brand-amber to-brand-rust hover:brightness-110 text-white text-xs md:text-sm font-bold tracking-wide px-6 py-3 rounded-xl shadow-lg shadow-brand-rust/20 hover:shadow-brand-rust/40 transition-all duration-300 active:scale-[0.97] hover:-translate-y-0.5 inline-block">
          Request Care Intake
        </a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="relative pt-16 pb-28 border-b border-brand-border/50 overflow-hidden">
    <div class="max-w-[85rem] mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative z-10">
      <div class="lg:col-span-6 space-y-6 reveal-up">
        <div class="inline-flex items-center gap-2 glass-card px-4 py-1.5 rounded-full hover:-translate-y-0.5 transition-transform duration-300">
          <span class="text-xs font-bold uppercase tracking-wider text-brand-rust">Castleton & Greater Indianapolis</span>
        </div>

        <h1 class="text-4xl sm:text-5xl xl:text-6xl font-black text-brand-dark tracking-tight leading-[1.12]">
          Compassionate hands. <br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-amber to-brand-rust">Dignity at home.</span>
        </h1>

        <p class="text-lg text-brand-muted max-w-xl leading-relaxed">
          Dependable non-medical home assistance built to safeguard personal independence, comfort families, and support daily living right in the place loved ones know best.
        </p>

        <div class="pt-2 flex flex-col sm:flex-row gap-4">
          <a href="#inquiry" class="inline-flex justify-center items-center bg-brand-dark hover:bg-black text-white font-bold px-7 py-4 rounded-xl shadow-xl hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 active:scale-[0.97]">
            Start Care Intake
          </a>
          <a href="tel:3176063803" class="glass-card inline-flex justify-center items-center gap-2 border-2 border-white/80 hover:border-brand-amber hover:bg-white text-brand-dark font-bold px-6 py-4 rounded-xl hover:-translate-y-1 transition-all duration-300 active:scale-[0.97]">
            (317) 606-3803
          </a>
        </div>

        <div class="pt-4 flex flex-wrap items-center gap-6 text-xs text-brand-dark font-semibold">
          <span class="flex items-center gap-2 hover:text-brand-rust transition-colors cursor-default">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-amber"></span>
            Personal Service Agency
          </span>
          <span class="flex items-center gap-2 hover:text-brand-rust transition-colors cursor-default">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-amber"></span>
            Certified Caregivers
          </span>
          <span class="flex items-center gap-2 hover:text-brand-rust transition-colors cursor-default">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-amber"></span>
            Custom Scheduling
          </span>
        </div>
      </div>

      <div class="lg:col-span-6 reveal-up" style="transition-delay: 150ms;">
        <div class="relative w-full mx-auto animate-float">
          <div class="rounded-[2rem] p-2 glass-card backdrop-blur-2xl bg-white/40">
            <div class="rounded-3xl overflow-hidden shadow-2xl aspect-[16/10] md:aspect-[3/2] bg-stone-200 relative">
              <img 
                src="./1000091103.jpg" 
                alt="Caregiver smiling while pushing an elderly woman in a wheelchair down a hallway" 
                class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-700"
              />
            </div>
          </div>
          <div class="absolute -bottom-6 -left-6 lg:-left-10 glass-card bg-white/80 rounded-2xl p-5 shadow-xl flex items-center gap-4 hover:-translate-y-2 transition-transform duration-300 z-20">
            <div class="w-12 h-12 rounded-xl bg-white/50 border border-white flex items-center justify-center font-bold text-brand-rust text-lg shadow-sm">
              IN
            </div>
            <div>
              <p class="text-xs text-brand-muted font-medium">Castleton Office</p>
              <p class="text-sm font-black text-brand-dark">8250 Bash St, Suite C1</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature Pillars (Glassmorphism Cards) -->
  <section class="relative -mt-12 max-w-7xl mx-auto px-6 z-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="reveal-up glass-card p-8 rounded-2xl hover:-translate-y-2 hover:bg-white/80 hover:shadow-2xl transition-all duration-400 group cursor-default">
        <div class="w-12 h-12 rounded-xl bg-white border border-white/80 text-brand-rust shadow-sm flex items-center justify-center mb-5 font-bold group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300">
          01
        </div>
        <h3 class="text-lg font-extrabold text-brand-dark mb-2">Medication Reminders</h3>
        <p class="text-sm text-brand-muted leading-relaxed">Daily routines kept consistent. On-time reminders for prescriptions, supplements, and fluid intake.</p>
      </div>

      <div class="reveal-up glass-card p-8 rounded-2xl hover:-translate-y-2 hover:bg-white/80 hover:shadow-2xl transition-all duration-400 group cursor-default" style="transition-delay: 100ms;">
        <div class="w-12 h-12 rounded-xl bg-white border border-white/80 text-brand-rust shadow-sm flex items-center justify-center mb-5 font-bold group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300">
          02
        </div>
        <h3 class="text-lg font-extrabold text-brand-dark mb-2">Companionship & Chores</h3>
        <p class="text-sm text-brand-muted leading-relaxed">Active companionship, nutritious meal prep, fresh bed linens, and keeping living spaces safe and tidy.</p>
      </div>

      <div class="reveal-up glass-card p-8 rounded-2xl hover:-translate-y-2 hover:bg-white/80 hover:shadow-2xl transition-all duration-400 group cursor-default" style="transition-delay: 200ms;">
        <div class="w-12 h-12 rounded-xl bg-white border border-white/80 text-brand-rust shadow-sm flex items-center justify-center mb-5 font-bold group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300">
          03
        </div>
        <h3 class="text-lg font-extrabold text-brand-dark mb-2">Personal Care Assistance</h3>
        <p class="text-sm text-brand-muted leading-relaxed">Dignified, patient help with bathing, dressing, grooming, and safe mobility transfers around the home.</p>
      </div>
    </div>
  </section>

  <!-- Complete Services Grid -->
  <section id="services" class="py-24 max-w-7xl mx-auto px-6 relative">
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-3 reveal-up">
      <span class="text-brand-rust text-xs font-bold uppercase tracking-widest">Our Service Scope</span>
      <h2 class="text-3xl sm:text-4xl font-black text-brand-dark">Dedicated In-Home Support</h2>
      <p class="text-brand-muted text-base">Attentive non-medical services matched to your loved one’s personal schedule.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <div class="reveal-up glass-card p-8 rounded-2xl hover:border-brand-amber/50 hover:shadow-xl hover:-translate-y-1.5 transition-all duration-400 group">
        <h4 class="text-xl font-bold text-brand-dark mb-3 group-hover:text-brand-rust transition-colors">Hygiene & Personal Care</h4>
        <p class="text-sm text-brand-muted leading-relaxed mb-4">Support with showers, sponge baths, personal hygiene, and daily grooming routines administered with complete patience and respect.</p>
        <span class="text-xs font-bold text-brand-rust bg-brand-rust/5 px-3 py-1 rounded-full">Bathing · Grooming · Dressing</span>
      </div>

      <div class="reveal-up glass-card p-8 rounded-2xl hover:border-brand-amber/50 hover:shadow-xl hover:-translate-y-1.5 transition-all duration-400 group">
        <h4 class="text-xl font-bold text-brand-dark mb-3 group-hover:text-brand-rust transition-colors">Mobility & Transfers</h4>
        <p class="text-sm text-brand-muted leading-relaxed mb-4">Hands-on support moving safely between beds, recliners, and wheelchairs, plus active fall prevention around the house.</p>
        <span class="text-xs font-bold text-brand-rust bg-brand-rust/5 px-3 py-1 rounded-full">Transfer Help · Walking Support</span>
      </div>

      <div class="reveal-up glass-card p-8 rounded-2xl hover:border-brand-amber/50 hover:shadow-xl hover:-translate-y-1.5 transition-all duration-400 group">
        <h4 class="text-xl font-bold text-brand-dark mb-3 group-hover:text-brand-rust transition-colors">Fresh Meal Preparation</h4>
        <p class="text-sm text-brand-muted leading-relaxed mb-4">Nutritious meals prepared according to specific dietary needs, keeping clients energized, well-hydrated, and satisfied.</p>
        <span class="text-xs font-bold text-brand-rust bg-brand-rust/5 px-3 py-1 rounded-full">Cooking · Meal Prep · Hydration</span>
      </div>

      <div class="reveal-up glass-card p-8 rounded-2xl hover:border-brand-amber/50 hover:shadow-xl hover:-translate-y-1.5 transition-all duration-400 group">
        <h4 class="text-xl font-bold text-brand-dark mb-3 group-hover:text-brand-rust transition-colors">Errands & Local Travel</h4>
        <p class="text-sm text-brand-muted leading-relaxed mb-4">Reliable accompaniment for prescription runs, grocery shopping, and medical appointments throughout Indianapolis.</p>
        <span class="text-xs font-bold text-brand-rust bg-brand-rust/5 px-3 py-1 rounded-full">Doctor Visits · Grocery · Pharmacy</span>
      </div>

      <div class="reveal-up glass-card p-8 rounded-2xl hover:border-brand-amber/50 hover:shadow-xl hover:-translate-y-1.5 transition-all duration-400 group">
        <h4 class="text-xl font-bold text-brand-dark mb-3 group-hover:text-brand-rust transition-colors">Respite Care for Families</h4>
        <p class="text-sm text-brand-muted leading-relaxed mb-4">Essential rest for family caregivers. Step away for an afternoon or a weekend with total peace of mind.</p>
        <span class="text-xs font-bold text-brand-rust bg-brand-rust/5 px-3 py-1 rounded-full">Hourly · Day Shifts · Relief Care</span>
      </div>

      <div class="reveal-up glass-card p-8 rounded-2xl hover:border-brand-amber/50 hover:shadow-xl hover:-translate-y-1.5 transition-all duration-400 group">
        <h4 class="text-xl font-bold text-brand-dark mb-3 group-hover:text-brand-rust transition-colors">Light Housekeeping</h4>
        <p class="text-sm text-brand-muted leading-relaxed mb-4">Maintaining a sanitary environment with laundry, dishes, trash removal, and clutter-free walking paths.</p>
        <span class="text-xs font-bold text-brand-rust bg-brand-rust/5 px-3 py-1 rounded-full">Tidying · Linens · Clutter Removal</span>
      </div>
    </div>
  </section>

  <!-- Metric Strip with Subtle Depth -->
  <section class="bg-brand-dark py-16 text-white border-y border-stone-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-brand-dark via-stone-900 to-brand-dark opacity-50"></div>
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-8 text-center relative z-10">
      <div class="hover:-translate-y-1 transition-transform duration-300">
        <div class="text-4xl sm:text-5xl font-black text-brand-amber counter" data-target="7">0</div>
        <div class="text-xs sm:text-sm text-stone-300 mt-2 font-medium">Days a Week Available</div>
      </div>
      <div class="hover:-translate-y-1 transition-transform duration-300">
        <div class="text-4xl sm:text-5xl font-black text-brand-amber counter" data-target="100">0</div>
        <div class="text-xs sm:text-sm text-stone-300 mt-2 font-medium">% Tailored Care Plans</div>
      </div>
      <div class="hover:-translate-y-1 transition-transform duration-300">
        <div class="text-4xl sm:text-5xl font-black text-brand-amber counter" data-target="46250">0</div>
        <div class="text-xs sm:text-sm text-stone-300 mt-2 font-medium">Castleton & Marion Hub</div>
      </div>
      <div class="hover:-translate-y-1 transition-transform duration-300">
        <div class="text-4xl sm:text-5xl font-black text-brand-amber counter" data-target="1">0</div>
        <div class="text-xs sm:text-sm text-stone-300 mt-2 font-medium">Clear Priority: Independence</div>
      </div>
    </div>
  </section>

  <!-- Step-by-Step Care Journey -->
  <section id="process" class="py-24 max-w-7xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-3 reveal-up">
      <span class="text-brand-rust text-xs font-bold uppercase tracking-wider">Simple Steps</span>
      <h2 class="text-3xl sm:text-4xl font-black text-brand-dark">How We Begin Care</h2>
      <p class="text-brand-muted">A clear, supportive path to setting up in-home assistance.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="reveal-up glass-card p-7 rounded-2xl hover:shadow-xl hover:-translate-y-1.5 transition-all duration-400">
        <span class="text-brand-rust bg-white px-3 py-1 rounded border border-brand-border/50 shadow-sm font-mono font-bold text-xs">Step 01</span>
        <h4 class="text-lg font-bold text-brand-dark mt-4 mb-2">Initial Call</h4>
        <p class="text-sm text-brand-muted leading-relaxed">Reach out directly to outline your current routine, challenges, and scheduling requirements.</p>
      </div>

      <div class="reveal-up glass-card p-7 rounded-2xl hover:shadow-xl hover:-translate-y-1.5 transition-all duration-400">
        <span class="text-brand-rust bg-white px-3 py-1 rounded border border-brand-border/50 shadow-sm font-mono font-bold text-xs">Step 02</span>
        <h4 class="text-lg font-bold text-brand-dark mt-4 mb-2">Free Assessment</h4>
        <p class="text-sm text-brand-muted leading-relaxed">We sit down together to review physical needs, safety checks, and preferred schedules.</p>
      </div>

      <div class="reveal-up glass-card p-7 rounded-2xl hover:shadow-xl hover:-translate-y-1.5 transition-all duration-400">
        <span class="text-brand-rust bg-white px-3 py-1 rounded border border-brand-border/50 shadow-sm font-mono font-bold text-xs">Step 03</span>
        <h4 class="text-lg font-bold text-brand-dark mt-4 mb-2">Caregiver Match</h4>
        <p class="text-sm text-brand-muted leading-relaxed">Pairing you with a compatible, background-checked professional who fits your family dynamic.</p>
      </div>

      <div class="reveal-up glass-card p-7 rounded-2xl hover:shadow-xl hover:-translate-y-1.5 transition-all duration-400">
        <span class="text-brand-rust bg-white px-3 py-1 rounded border border-brand-border/50 shadow-sm font-mono font-bold text-xs">Step 04</span>
        <h4 class="text-lg font-bold text-brand-dark mt-4 mb-2">Care Commences</h4>
        <p class="text-sm text-brand-muted leading-relaxed">Care begins on your terms, with continuous agency communication and active oversight.</p>
      </div>
    </div>
  </section>

  <!-- Friction Reduction: Insurance Providers Grid -->
  <section class="max-w-4xl mx-auto px-6 mb-8 reveal-up">
    <div class="glass-card rounded-2xl p-6 flex flex-col md:flex-row items-center justify-between gap-6 border-brand-border text-center md:text-left">
      <div>
        <h4 class="text-sm font-bold text-brand-dark">Accepted Coverages & Payment</h4>
        <p class="text-xs text-brand-muted mt-1">We navigate coverage checks to minimize out-of-pocket friction.</p>
      </div>
      <div class="flex flex-wrap justify-center items-center gap-4 text-xs font-bold text-stone-500 uppercase tracking-widest">
        <span class="px-3 py-1.5 bg-white/60 rounded border border-white shadow-sm">Medicaid</span>
        <span class="px-3 py-1.5 bg-white/60 rounded border border-white shadow-sm">Pathways</span>
        <span class="px-3 py-1.5 bg-white/60 rounded border border-white shadow-sm">Private Pay</span>
      </div>
    </div>
  </section>

  <!-- Complete Intake Form Section -->
  <section id="inquiry" class="py-20 relative">
    <div class="max-w-4xl mx-auto px-6 relative z-10">
      
      <!-- Frosted Glass Form Container -->
      <div class="glass-card bg-white/70 backdrop-blur-2xl p-8 md:p-12 rounded-[2rem] border border-white shadow-2xl shadow-stone-300/40">
        
        <div class="text-center max-w-xl mx-auto mb-10 space-y-2 reveal-up">
          <span class="text-brand-rust text-xs font-bold uppercase tracking-widest bg-brand-rust/5 px-3 py-1 rounded-full">Client Intake</span>
          <h2 class="text-3xl font-black text-brand-dark tracking-tight">Request Home Care Services</h2>
          <p class="text-sm text-brand-muted leading-relaxed">
            Provide the client's information below so our care coordinator can verify coverage and review schedule availability.
          </p>
        </div>

        <form 
          action="https://api.web3forms.com/submit" 
          method="POST" 
          class="space-y-8 reveal-up"
        >
          <!-- Exact Lowercase Web3Forms Access Key -->
          <input type="hidden" name="access_key" value="c31a3a15-cc8b-4626-906c-1a76d5fb6a30" />
          <input type="hidden" name="subject" value="New Patient Care Intake" />
          <input type="hidden" name="from_name" value="Loving People Care Desk" />

          <!-- Section 1: Client & Contact Info -->
          <div class="space-y-4">
            <h3 class="text-xs font-bold uppercase tracking-wider text-brand-dark border-b border-white/80 pb-2">
              1. Client & Contact Information
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1">First Name</label>
                <input 
                  type="text" 
                  name="client_first_name" 
                  required 
                  placeholder="First name" 
                  class="w-full px-4 py-3 rounded-xl border border-white/80 shadow-inner bg-white/50 text-sm focus:outline-none focus:bg-white focus:border-brand-amber focus:ring-2 focus:ring-brand-amber/20 transition-all duration-300" 
                />
              </div>
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1">Last Name</label>
                <input 
                  type="text" 
                  name="client_last_name" 
                  required 
                  placeholder="Last name" 
                  class="w-full px-4 py-3 rounded-xl border border-white/80 shadow-inner bg-white/50 text-sm focus:outline-none focus:bg-white focus:border-brand-amber focus:ring-2 focus:ring-brand-amber/20 transition-all duration-300" 
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1">Contact Phone Number</label>
                <input 
                  type="tel" 
                  name="phone_number" 
                  required 
                  placeholder="(317) 000-0000" 
                  class="w-full px-4 py-3 rounded-xl border border-white/80 shadow-inner bg-white/50 text-sm focus:outline-none focus:bg-white focus:border-brand-amber focus:ring-2 focus:ring-brand-amber/20 transition-all duration-300" 
                />
              </div>
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-brand-dark mb-1">Email Address</label>
                <input 
                  type="email" 
