---
import '../styles/global.css';
---
<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Loving People Home Health Care | Indianapolis, IN</title>
  <link rel="icon" type="image/png" href="/logo.png" />
</head>
<body class="bg-brand-warm text-brand-muted font-sans antialiased selection:bg-brand-amber/20 selection:text-brand-dark">

  <!-- Top Announcement Bar -->
  <div class="bg-brand-dark text-white text-xs sm:text-sm py-2.5 px-6 border-b border-brand-dark/50">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-brand-amber animate-pulse"></span>
        <span class="text-stone-300 font-medium tracking-wide">Accepting New Clients Across Marion County & Central Indiana</span>
      </div>
      <div class="flex items-center gap-6">
        <a href="tel:3177179077" class="hover:text-brand-amber transition-colors font-semibold flex items-center gap-1.5">
          <svg class="w-4 h-4 text-brand-amber" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
          (317) 717-9077
        </a>
        <span class="hidden md:inline text-stone-600">|</span>
        <span class="hidden md:inline text-stone-400">Mon–Fri: 9AM–6PM · Sat–Sun: 10AM–4PM</span>
      </div>
    </div>
  </div>

  <!-- Primary Sticky Header -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-brand-border">
    <div class="max-w-7xl mx-auto px-6 h-24 flex items-center justify-between">
      
      <!-- Brand Logo Placement -->
      <a href="#" class="flex items-center group shrink-0">
        <img 
          src="/logo.png" 
          alt="Loving People Home Health Care" 
          class="w-auto object-contain mix-blend-multiply transition-transform duration-300 group-hover:scale-105"
          style="max-height: 4.5rem; height: 4.5rem;"
        />
      </a>

      <!-- Navigation Links -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-brand-dark">
        <a href="#services" class="hover:text-brand-rust transition">Care Services</a>
        <a href="#process" class="hover:text-brand-rust transition">How It Works</a>
        <a href="#contact" class="hover:text-brand-rust transition">Castleton Office</a>
      </nav>

      <!-- CTA Button -->
      <div>
        <a href="#contact" class="bg-gradient-to-r from-brand-amber to-brand-rust hover:brightness-105 text-white text-xs md:text-sm font-bold tracking-wide px-6 py-3 rounded-xl shadow-md shadow-brand-rust/20 transition-all active:scale-95 inline-block">
          Request Free Assessment
        </a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="relative bg-white pt-16 pb-28 border-b border-brand-border overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 bg-brand-warm border border-brand-border px-4 py-1.5 rounded-full">
          <span class="text-xs font-bold uppercase tracking-wider text-brand-rust">Castleton & Greater Indianapolis</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-brand-dark tracking-tight leading-[1.12]">
          Compassionate hands. <br />
          <span class="logo-gradient-text">Dignity at home.</span>
        </h1>

        <p class="text-lg text-brand-muted max-w-xl leading-relaxed">
          Dependable non-medical home assistance built to safeguard personal independence, comfort families, and support daily living right in the place loved ones know best.
        </p>

        <div class="pt-2 flex flex-col sm:flex-row gap-4">
          <a href="#contact" class="inline-flex justify-center items-center bg-brand-dark hover:bg-black text-white font-bold px-7 py-4 rounded-xl shadow-lg transition active:scale-95">
            Schedule Care Assessment
          </a>
          <a href="tel:3177179077" class="inline-flex justify-center items-center gap-2 border-2 border-brand-border hover:border-brand-amber text-brand-dark font-bold px-6 py-4 rounded-xl transition">
            (317) 717-9077
          </a>
        </div>

        <div class="pt-4 flex flex-wrap items-center gap-6 text-xs text-brand-muted font-semibold">
          <span class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-amber"></span>
            Personal Service Agency
          </span>
          <span class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-amber"></span>
            Certified Caregivers
          </span>
          <span class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-amber"></span>
            Custom Scheduling
          </span>
        </div>
      </div>

      <!-- Hero Visual Frame -->
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <div class="rounded-3xl overflow-hidden shadow-2xl border-4 border-brand-warm aspect-[4/3] bg-stone-200">
            <img 
              src="https://images.unsplash.com/photo-1576765608535-5f04d1e3f289?auto=format&fit=crop&w=1000&q=80" 
              alt="Caregiver with client" 
              class="w-full h-full object-cover"
            />
          </div>
          <div class="absolute -bottom-6 -left-6 bg-white rounded-2xl p-5 shadow-xl border border-brand-border flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-brand-warm border border-brand-border flex items-center justify-center font-bold text-brand-rust text-lg">
              IN
            </div>
            <div>
              <p class="text-xs text-brand-muted font-medium">Castleton Office</p>
              <p class="text-sm font-black text-brand-dark">8250 Bash St, Suite C1</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature Pillars -->
  <section class="relative -mt-12 max-w-7xl mx-auto px-6 z-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="reveal-up bg-white p-8 rounded-2xl border border-brand-border shadow-lg shadow-stone-200/40 hover:-translate-y-1.5 transition-transform duration-300">
        <div class="w-12 h-12 rounded-xl bg-brand-warm text-brand-rust border border-brand-border flex items-center justify-center mb-5 font-bold">
          01
        </div>
        <h3 class="text-lg font-extrabold text-brand-dark mb-2">Medication Reminders</h3>
        <p class="text-sm text-brand-muted leading-relaxed">Daily routines kept consistent. On-time reminders for prescriptions, supplements, and fluid intake.</p>
      </div>

      <div class="reveal-up bg-white p-8 rounded-2xl border border-brand-border shadow-lg shadow-stone-200/40 hover:-translate-y-1.5 transition-transform duration-300">
        <div class="w-12 h-12 rounded-xl bg-brand-warm text-brand-rust border border-brand-border flex items-center justify-center mb-5 font-bold">
          02
        </div>
        <h3 class="text-lg font-extrabold text-brand-dark mb-2">Companionship & Chores</h3>
        <p class="text-sm text-brand-muted leading-relaxed">Active companionship, nutritious meal prep, fresh bed linens, and keeping living spaces safe and tidy.</p>
      </div>

      <div class="reveal-up bg-white p-8 rounded-2xl border border-brand-border shadow-lg shadow-stone-200/40 hover:-translate-y-1.5 transition-transform duration-300">
        <div class="w-12 h-12 rounded-xl bg-brand-warm text-brand-rust border border-brand-border flex items-center justify-center mb-5 font-bold">
          03
        </div>
        <h3 class="text-lg font-extrabold text-brand-dark mb-2">Personal Care Assistance</h3>
        <p class="text-sm text-brand-muted leading-relaxed">Dignified, patient help with bathing, dressing, grooming, and safe mobility transfers around the home.</p>
      </div>
    </div>
  </section>

  <!-- Complete Services Grid -->
  <section id="services" class="py-24 max-w-7xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
      <span class="text-brand-rust text-xs font-bold uppercase tracking-widest">Our Service Scope</span>
      <h2 class="text-3xl sm:text-4xl font-black text-brand-dark">Dedicated In-Home Support</h2>
      <p class="text-brand-muted text-base">Attentive non-medical services matched to your loved one’s personal schedule.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <div class="reveal-up bg-white p-8 rounded-2xl border border-brand-border hover:border-brand-amber transition shadow-sm hover:shadow-md">
        <h4 class="text-xl font-bold text-brand-dark mb-3">Hygiene & Personal Care</h4>
        <p class="text-sm text-brand-muted leading-relaxed mb-4">Support with showers, sponge baths, personal hygiene, and daily grooming routines administered with complete patience and respect.</p>
        <span class="text-xs font-bold text-brand-rust">Bathing · Grooming · Dressing</span>
      </div>

      <div class="reveal-up bg-white p-8 rounded-2xl border border-brand-border hover:border-brand-amber transition shadow-sm hover:shadow-md">
        <h4 class="text-xl font-bold text-brand-dark mb-3">Mobility & Transfers</h4>
        <p class="text-sm text-brand-muted leading-relaxed mb-4">Hands-on support moving safely between beds, recliners, and wheelchairs, plus active fall prevention around the house.</p>
        <span class="text-xs font-bold text-brand-rust">Transfer Help · Walking Support</span>
      </div>

      <div class="reveal-up bg-white p-8 rounded-2xl border border-brand-border hover:border-brand-amber transition shadow-sm hover:shadow-md">
        <h4 class="text-xl font-bold text-brand-dark mb-3">Fresh Meal Preparation</h4>
        <p class="text-sm text-brand-muted leading-relaxed mb-4">Nutritious meals prepared according to specific dietary needs, keeping clients energized, well-hydrated, and satisfied.</p>
        <span class="text-xs font-bold text-brand-rust">Cooking · Meal Prep · Hydration</span>
      </div>

      <div class="reveal-up bg-white p-8 rounded-2xl border border-brand-border hover:border-brand-amber transition shadow-sm hover:shadow-md">
        <h4 class="text-xl font-bold text-brand-dark mb-3">Errands & Local Travel</h4>
        <p class="text-sm text-brand-muted leading-relaxed mb-4">Reliable accompaniment for prescription runs, grocery shopping, and medical appointments throughout Indianapolis.</p>
        <span class="text-xs font-bold text-brand-rust">Doctor Visits · Grocery · Pharmacy</span>
      </div>

      <div class="reveal-up bg-white p-8 rounded-2xl border border-brand-border hover:border-brand-amber transition shadow-sm hover:shadow-md">
        <h4 class="text-xl font-bold text-brand-dark mb-3">Respite Care for Families</h4>
        <p class="text-sm text-brand-muted leading-relaxed mb-4">Essential rest for family caregivers. Step away for an afternoon or a weekend with total peace of mind.</p>
        <span class="text-xs font-bold text-brand-rust">Hourly · Day Shifts · Relief Care</span>
      </div>

      <div class="reveal-up bg-white p-8 rounded-2xl border border-brand-border hover:border-brand-amber transition shadow-sm hover:shadow-md">
        <h4 class="text-xl font-bold text-brand-dark mb-3">Light Housekeeping</h4>
        <p class="text-sm text-brand-muted leading-relaxed mb-4">Maintaining a sanitary environment with laundry, dishes, trash removal, and clutter-free walking paths.</p>
        <span class="text-xs font-bold text-brand-rust">Tidying · Linens · Clutter Removal</span>
      </div>
    </div>
  </section>

  <!-- Metric Strip -->
  <section class="bg-brand-dark py-16 text-white border-y border-stone-800">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div>
        <div class="text-4xl sm:text-5xl font-black text-brand-amber counter" data-target="7">0</div>
        <div class="text-xs sm:text-sm text-stone-300 mt-2 font-medium">Days a Week Available</div>
      </div>
      <div>
        <div class="text-4xl sm:text-5xl font-black text-brand-amber counter" data-target="100">0</div>
        <div class="text-xs sm:text-sm text-stone-300 mt-2 font-medium">% Tailored Care Plans</div>
      </div>
      <div>
        <div class="text-4xl sm:text-5xl font-black text-brand-amber counter" data-target="46250">0</div>
        <div class="text-xs sm:text-sm text-stone-300 mt-2 font-medium">Castleton & Marion Hub</div>
      </div>
      <div>
        <div class="text-4xl sm:text-5xl font-black text-brand-amber counter" data-target="1">0</div>
        <div class="text-xs sm:text-sm text-stone-300 mt-2 font-medium">Clear Priority: Independence</div>
      </div>
    </div>
  </section>

  <!-- Step-by-Step Care Journey -->
  <section id="process" class="py-24 max-w-7xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
      <span class="text-brand-rust text-xs font-bold uppercase tracking-wider">Simple Steps</span>
      <h2 class="text-3xl sm:text-4xl font-black text-brand-dark">How We Begin Care</h2>
      <p class="text-brand-muted">A clear, supportive path to setting up in-home assistance.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="reveal-up bg-white p-7 rounded-2xl border border-brand-border">
        <span class="text-brand-rust font-mono font-bold text-xs">Step 01</span>
        <h4 class="text-lg font-bold text-brand-dark mt-2 mb-2">Initial Call</h4>
        <p class="text-sm text-brand-muted leading-relaxed">Reach out directly to outline your current routine, challenges, and scheduling requirements.</p>
      </div>

      <div class="reveal-up bg-white p-7 rounded-2xl border border-brand-border">
        <span class="text-brand-rust font-mono font-bold text-xs">Step 02</span>
        <h4 class="text-lg font-bold text-brand-dark mt-2 mb-2">Free Assessment</h4>
        <p class="text-sm text-brand-muted leading-relaxed">We sit down together to review physical needs, safety checks, and preferred schedules.</p>
      </div>

      <div class="reveal-up bg-white p-7 rounded-2xl border border-brand-border">
        <span class="text-brand-rust font-mono font-bold text-xs">Step 03</span>
        <h4 class="text-lg font-bold text-brand-dark mt-2 mb-2">Caregiver Match</h4>
        <p class="text-sm text-brand-muted leading-relaxed">Pairing you with a compatible, background-checked professional who fits your family dynamic.</p>
      </div>

      <div class="reveal-up bg-white p-7 rounded-2xl border border-brand-border">
        <span class="text-brand-rust font-mono font-bold text-xs">Step 04</span>
        <h4 class="text-lg font-bold text-brand-dark mt-2 mb-2">Care Commences</h4>
        <p class="text-sm text-brand-muted leading-relaxed">Care begins on your terms, with continuous agency communication and active oversight.</p>
      </div>
    </div>
  </section>

  <!-- Location & Contact Form -->
  <section id="contact" class="py-20 bg-brand-warm border-t border-brand-border">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5 space-y-6">
        <div>
          <span class="text-brand-rust text-xs font-bold uppercase tracking-wider">Direct Office Access</span>
          <h3 class="text-3xl font-black text-brand-dark mt-1">Visit or Contact Us</h3>
          <p class="text-brand-muted text-sm mt-2">Conveniently located near Castleton and Binford Boulevard in northeast Indianapolis.</p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-brand-border space-y-4 text-sm">
          <div class="flex items-start gap-3">
            <div>
              <p class="font-bold text-brand-dark">Castleton Office</p>
              <p class="text-brand-muted">8250 Bash Street, Suite C1<br/>Indianapolis, IN 46250</p>
            </div>
          </div>

          <div class="border-t border-brand-border/60 pt-3">
            <p class="font-bold text-brand-dark">Direct Phone</p>
            <a href="tel:3177179077" class="text-brand-rust hover:underline font-bold text-base">(317) 717-9077</a>
          </div>

          <div class="border-t border-brand-border/60 pt-3">
            <p class="font-bold text-brand-dark">Agency Hours</p>
            <p class="text-brand-muted">Monday – Friday: 9:00 AM – 6:00 PM</p>
            <p class="text-brand-muted">Saturday – Sunday: 10:00 AM – 4:00 PM</p>
          </div>
        </div>
      </div>

      <!-- Lead Capture Form -->
      <div class="lg:col-span-7">
        <div class="bg-white p-8 md:p-10 rounded-2xl border border-brand-border shadow-md">
          <h3 class="text-2xl font-black text-brand-dark mb-1">Make An Inquiry</h3>
          <p class="text-sm text-brand-muted mb-6">Fill out the form below and an agency coordinator will contact you promptly.</p>

          <form action="#" method="POST" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1">Full Name</label>
                <input type="text" required placeholder="First and last name" class="w-full px-4 py-3 rounded-xl border border-brand-border text-sm bg-brand-warm/30" />
              </div>
              <div>
                <label class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1">Phone Number</label>
                <input type="tel" required placeholder="(317) 000-0000" class="w-full px-4 py-3 rounded-xl border border-brand-border text-sm bg-brand-warm/30" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1">Inquiring For</label>
              <select class="w-full px-4 py-3 rounded-xl border border-brand-border text-sm bg-brand-warm/30">
                <option>Parent</option>
                <option>Spouse</option>
                <option>Myself</option>
                <option>Other Family Member / Client</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1">Services of Interest</label>
              <input type="text" placeholder="e.g. Hygiene care, transfer assistance, companionship" class="w-full px-4 py-3 rounded-xl border border-brand-border text-sm bg-brand-warm/30" />
            </div>

            <button type="submit" class="w-full bg-gradient-to-r from-brand-amber to-brand-rust hover:brightness-105 text-white font-bold py-4 rounded-xl transition shadow-md shadow-brand-rust/20 active:scale-[0.99]">
              Send Care Request
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-brand-dark text-stone-400 py-14 border-t border-stone-800 text-sm">
    <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-8">
      <div class="flex items-center gap-4 shrink-0">
        <img 
          src="/logo.png" 
          alt="Loving People Home Health Care" 
          class="w-auto object-contain mix-blend-multiply brightness-110" 
          style="max-height: 3.5rem; height: 3.5rem;"
        />
        <div>
          <p class="text-white font-black text-base uppercase tracking-tight">Loving People Home Health Care</p>
          <p class="text-xs text-stone-400">8250 Bash St, Suite C1 · Indianapolis, IN 46250</p>
        </div>
      </div>

      <div class="flex gap-6 text-xs font-semibold">
        <a href="#services" class="hover:text-white transition">Services</a>
        <a href="#process" class="hover:text-white transition">Care Process</a>
        <a href="#contact" class="hover:text-white transition">Location</a>
        <a href="tel:3177179077" class="hover:text-white transition">Direct Line</a>
      </div>

      <p class="text-xs text-stone-500">© 2026 Loving People Home Health Care. All rights reserved.</p>
    </div>
  </footer>

  <!-- Scroll and Counter Observer Scripts -->
  <script is:inline>
    const revealItems = document.querySelectorAll('.reveal-up');
    const scrollObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry, i) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.classList.add('active');
          }, (i % 3) * 120);
          scrollObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    revealItems.forEach((el) => scrollObserver.observe(el));

    const counters = document.querySelectorAll('.counter');
    const counterObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const target = +(entry.target.getAttribute('data-target') || '0');
          let count = 0;
          const step = Math.ceil(target / 35);
          const interval = setInterval(() => {
            count += step;
            if (count >= target) {
              entry.target.textContent = target.toLocaleString();
              clearInterval(interval);
            } else {
              entry.target.textContent = count.toLocaleString();
            }
          }, 35);
          counterObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });
    counters.forEach((c) => counterObserver.observe(c));
  </script>
</body>
</html>
