---
---
<section id="contact" class="py-20 bg-brand-warm border-t border-brand-border">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12">
    
    <div class="lg:col-span-5 space-y-6">
      <div>
        <span class="text-brand-rust text-xs font-bold uppercase tracking-wider">Direct Office Access</span>
        <h3 class="text-3xl font-black text-brand-dark mt-1">Visit or Contact Us</h3>
        <p class="text-brand-muted text-sm mt-2">Conveniently located near Castleton and Binford Boulevard in northeast Indianapolis.</p>
      </div>

      <div class="bg-white p-6 rounded-2xl border border-brand-border space-y-4 text-sm">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-brand-rust shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <div>
            <p class="font-bold text-brand-dark">Castleton Office</p>
            <p class="text-brand-muted">8250 Bash Street, Suite C1<br/>Indianapolis, IN 46250</p>
          </div>
        </div>

        <div class="flex items-start gap-3 border-t border-brand-border/60 pt-3">
          <svg class="w-5 h-5 text-brand-rust shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <div>
            <p class="font-bold text-brand-dark">Direct Phone</p>
            <a href="tel:3177179077" class="text-brand-rust hover:underline font-bold text-base">(317) 717-9077</a>
          </div>
        </div>

        <div class="flex items-start gap-3 border-t border-brand-border/60 pt-3">
          <svg class="w-5 h-5 text-brand-rust shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <div>
            <p class="font-bold text-brand-dark">Agency Hours</p>
            <p class="text-brand-muted">Monday – Friday: 9:00 AM – 6:00 PM</p>
            <p class="text-brand-muted">Saturday – Sunday: 10:00 AM – 4:00 PM</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Form -->
    <div class="lg:col-span-7">
      <div class="bg-white p-8 md:p-10 rounded-2xl border border-brand-border shadow-md">
        <h3 class="text-2xl font-black text-brand-dark mb-1">Make An Inquiry</h3>
        <p class="text-sm text-brand-muted mb-6">Fill out the form below and an agency coordinator will contact you promptly.</p>

        <form action="https://formspree.io/f/your-form-id" method="POST" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1">Full Name</label>
              <input type="text" name="name" required placeholder="First and last name" class="w-full px-4 py-3 rounded-xl border border-brand-border text-sm focus:outline-none focus:border-brand-amber bg-brand-warm/30" />
            </div>
            <div>
              <label class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1">Phone Number</label>
              <input type="tel" name="phone" required placeholder="(317) 000-0000" class="w-full px-4 py-3 rounded-xl border border-brand-border text-sm focus:outline-none focus:border-brand-amber bg-brand-warm/30" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1">Inquiring For</label>
            <select name="relationship" class="w-full px-4 py-3 rounded-xl border border-brand-border text-sm focus:outline-none focus:border-brand-amber bg-brand-warm/30">
              <option value="parent">Parent</option>
              <option value="spouse">Spouse</option>
              <option value="myself">Myself</option>
              <option value="other">Other Family Member / Client</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-1">Services of Interest</label>
            <input type="text" name="services" placeholder="e.g. Hygiene care, transfer assistance, companionship" class="w-full px-4 py-3 rounded-xl border border-brand-border text-sm focus:outline-none focus:border-brand-amber bg-brand-warm/30" />
          </div>

          <button type="submit" class="w-full bg-gradient-to-r from-brand-amber to-brand-rust hover:brightness-105 text-white font-bold py-4 rounded-xl transition shadow-md shadow-brand-rust/20 active:scale-[0.99]">
            Send Care Request
          </button>
        </form>
      </div>
    </div>

  </div>
</section>
