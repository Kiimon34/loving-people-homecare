---
---
<section class="relative bg-white pt-16 pb-28 border-b border-brand-border overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    <div class="lg:col-span-7 space-y-6">
      
      <div class="inline-flex items-center gap-2 bg-brand-warm border border-brand-border px-4 py-1.5 rounded-full">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-rust">Castleton & Greater Indianapolis</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-brand-dark tracking-tight leading-[1.12]">
        Compassionate hands. <br />
        <span class="logo-gradient-text">Dignity at home.</span>
      </h1>

      <p class="text-lg text-brand-muted max-w-xl leading-relaxed">
        Dependable non-medical home assistance built to safeguard personal independence, comfort families, and support daily living right where loved ones feel most secure.
      </p>

      <div class="pt-2 flex flex-col sm:flex-row gap-4">
        <a href="#contact" class="inline-flex justify-center items-center bg-brand-dark hover:bg-black text-white font-bold px-7 py-4 rounded-xl shadow-lg transition active:scale-95">
          Schedule Care Assessment
        </a>
        <a href="tel:3177179077" class="inline-flex justify-center items-center gap-2 border-2 border-brand-border hover:border-brand-amber text-brand-dark font-bold px-6 py-4 rounded-xl transition">
          <svg class="w-4 h-4 text-brand-rust" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
          (317) 717-9077
        </a>
      </div>

      <div class="pt-4 flex flex-wrap items-center gap-6 text-xs text-brand-muted font-semibold">
        <span class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-amber"></span>
          Personal Service Agency
        </span>
        <span class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-amber"></span>
          Certified & Vetted Staff
        </span>
        <span class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-amber"></span>
          Custom Schedules
        </span>
      </div>
    </div>

    <!-- Visual Media -->
    <div class="lg:col-span-5">
      <div class="relative mx-auto max-w-md lg:max-w-none">
        <div class="rounded-3xl overflow-hidden shadow-2xl border-4 border-brand-warm aspect-[4/3] bg-stone-200">
          <img 
            src="https://images.unsplash.com/photo-1581579438747-1dc8d17bbce4?auto=format&fit=crop&w=1000&q=80" 
            alt="Caregiver assisting senior with dignity" 
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
        <div class="absolute -bottom-6 -left-6 bg-white rounded-2xl p-5 shadow-xl border border-brand-border flex items-center gap-4">
          <div class="w-12 h-12 rounded-xl bg-brand-warm border border-brand-border flex items-center justify-center font-bold text-brand-rust text-lg">
            IN
          </div>
          <div>
            <p class="text-xs text-brand-muted font-medium">Headquarters</p>
            <p class="text-sm font-black text-brand-dark">8250 Bash St, Suite C1</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
