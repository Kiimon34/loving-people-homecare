---
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-brand-border">
  <div class="max-w-7xl mx-auto px-6 h-24 flex items-center justify-between">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <img 
        src="/logo.png" 
        alt="Loving People Home Health Care" 
        class="h-16 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
      />
    </a>

    <!-- Nav Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-brand-dark">
      <a href="#services" class="hover:text-brand-rust transition">Care Services</a>
      <a href="#process" class="hover:text-brand-rust transition">How It Works</a>
      <a href="#contact" class="hover:text-brand-rust transition">Castleton Office</a>
    </nav>

    <!-- Header CTA -->
    <div>
      <a href="#contact" class="bg-gradient-to-r from-brand-amber to-brand-rust hover:brightness-105 text-white text-xs md:text-sm font-bold tracking-wide px-6 py-3 rounded-xl shadow-md shadow-brand-rust/20 transition-all active:scale-95">
        Request Free Assessment
      </a>
    </div>
  </div>
</header>
